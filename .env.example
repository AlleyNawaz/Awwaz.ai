# ==============================================================================
# AWWAZ ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base
APP_NAME=Awwaz
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite for immediate local execution. For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/awwaz
DATABASE_URL=sqlite+aiosqlite:///./awwaz.db
DATABASE_SYNC_URL=sqlite:///./awwaz.db

# Security & Sessions
AUTH_SECRET=awwaz_hackathon_demo_secret_key_32bytes_min_length_value
SESSION_COOKIE_NAME=awwaz_session
SESSION_MAX_AGE_SECONDS=86400

# ------------------------------------------------------------------------------
# AI Provider Configuration (OpenAI, OpenRouter, Google Cloud Vertex/Gemini)
# Supported providers: fixture, gemini, openai, openrouter
# ------------------------------------------------------------------------------
LLM_PROVIDER=fixture

# OpenAI Configuration (@OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter Gateway Configuration (@openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Cloud / Gemini AI (@googlecloud)
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Neural Search & Civic Knowledge Retrieval (Exa AI - @exaailabs)
# ------------------------------------------------------------------------------
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# ------------------------------------------------------------------------------
# Identity & Access Management (Auth0 - @auth0)
# ------------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# ------------------------------------------------------------------------------
# Cloud Background Jobs & Durable Execution (Trigger.dev - @triggerdotdev)
# ------------------------------------------------------------------------------
TRIGGER_API_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_API_URL=https://api.trigger.dev

# ------------------------------------------------------------------------------
# Operator Copilot Framework (CopilotKit - @CopilotKit)
# ------------------------------------------------------------------------------
COPILOTKIT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Trustworthy AI Alignment & Safety Guardrails (Mozilla AI - @mozillaAI)
# ------------------------------------------------------------------------------
MOZILLA_AI_SAFETY_ENABLED=true

# ------------------------------------------------------------------------------
# Citizen Intake Disambiguation Engine (Ambiguous AI - @ambiguousio)
# ------------------------------------------------------------------------------
AMBIGUOUS_AI_CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# Civic Service Adapter
# Options: mock, live (when authorized external connector available)
# ------------------------------------------------------------------------------
CIVIC_ADAPTER_TYPE=mock
CIVIC_SERVICE_BASE_URL=https://mock.civic.local/api/v1
CIVIC_ADAPTER_TIMEOUT_SECONDS=10

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Background Worker & SLA Thresholds
STALL_THRESHOLD_HOURS=72
COMMITMENT_CHECK_INTERVAL_SECONDS=60
