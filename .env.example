# ==============================================================================
# AWWAZ ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base
APP_NAME=Awwaz
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite for immediate local execution. For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/awwaz
DATABASE_URL=sqlite+aiosqlite:///./awwaz.db
DATABASE_SYNC_URL=sqlite:///./awwaz.db

# Security & Sessions
AUTH_SECRET=awwaz_hackathon_demo_secret_key_32bytes_min_length_value
SESSION_COOKIE_NAME=awwaz_session
SESSION_MAX_AGE_SECONDS=86400

# AI Provider Configuration
# Supported providers: fixture, gemini, openai
LLM_PROVIDER=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Civic Service Adapter
# Options: mock, live (when authorized external connector available)
CIVIC_ADAPTER_TYPE=mock
CIVIC_SERVICE_BASE_URL=https://mock.civic.local/api/v1
CIVIC_ADAPTER_TIMEOUT_SECONDS=10

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Background Worker & SLA Thresholds
STALL_THRESHOLD_HOURS=72
COMMITMENT_CHECK_INTERVAL_SECONDS=60
